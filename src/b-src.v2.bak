<title>ASL IP Rang</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap">
<style>
*,*::before,*::after{box-sizing:border-box}
:root{--bg:#ffffff;--bg2:#f6f4f7;--ink:#17141b;--muted:#6a6472;--line:#e4e0e8;--accent:#b8226a;--accent-t:#b8226a;--accent-soft:#fbe9f1;--on-accent:#ffffff;--logo-bg:#ffffff;
--fd:'Fraunces',Georgia,'Times New Roman',serif;--fb:'Instrument Sans','Helvetica Neue',Arial,sans-serif}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#151319;--bg2:#1d1a22;--ink:#f2eef5;--muted:#a49eac;--line:#2d2934;--accent:#d9377f;--accent-t:#f06ba7;--accent-soft:#33202a;--logo-bg:#151319}}
:root[data-theme="dark"]{--bg:#151319;--bg2:#1d1a22;--ink:#f2eef5;--muted:#a49eac;--line:#2d2934;--accent:#d9377f;--accent-t:#f06ba7;--accent-soft:#33202a;--logo-bg:#151319}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.6 var(--fb);-webkit-font-smoothing:antialiased}
:root[data-lang="uz"] .en,:root[data-lang="en"] .uz{display:none!important}
.wrap{width:min(1200px,100% - 48px);margin-inline:auto}
@media (max-width:640px){.wrap{width:calc(100% - 32px)}}
h1,h2,h3{font-family:var(--fd);font-weight:300;line-height:1.02;margin:0;text-wrap:balance;letter-spacing:-.01em;font-variation-settings:"opsz" 144,"SOFT" 30}
h3{font-weight:500;font-variation-settings:"opsz" 48,"SOFT" 30}
h1 em,h2 em{font-style:italic;color:var(--accent-t);font-weight:400}
p{margin:0}
a{color:inherit}
:focus-visible{outline:3px solid var(--accent-t);outline-offset:3px}
canvas{display:block;width:100%;height:100%}
.kicker{font:500 12.5px/1 var(--fb);letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
.btn{display:inline-flex;align-items:center;gap:10px;padding:14px 24px;background:var(--accent);color:var(--on-accent);font:600 15px/1 var(--fb);letter-spacing:.02em;text-decoration:none;border:0;border-radius:3px;cursor:pointer}
.btn:hover{filter:brightness(.92)}
.btn.line{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 1.5px var(--line)}
.btn.line:hover{box-shadow:inset 0 0 0 1.5px var(--ink);filter:none}
.more{font:600 15px/1 var(--fb);text-decoration:none;color:var(--accent-t);display:inline-flex;gap:8px;align-items:center;border-bottom:1.5px solid transparent;padding-bottom:3px}
.more:hover{border-color:currentColor}
/* header */
.hdr{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;background:var(--bg);border-bottom:1px solid var(--line)}
.hdr .wrap{display:flex;align-items:center;gap:32px;min-height:76px;position:relative}
.logo{display:block;color:var(--ink);height:42px;width:164px;flex:none}
.logo svg{width:100%;height:100%;display:block;overflow:visible}
.nav{display:flex;gap:26px;list-style:none;margin:0 auto;padding:0}
.nav a{text-decoration:none;font:500 15px/1 var(--fb);letter-spacing:.01em;padding:8px 0;border-bottom:1.5px solid transparent}
.nav a:hover{border-color:var(--ink)}
.tools{display:flex;align-items:center;gap:22px;flex:none}
.lang{display:flex;gap:10px;font:600 13px/1 var(--fb);letter-spacing:.1em}
.lang button{background:none;border:0;padding:6px 0;color:var(--muted);cursor:pointer;font:inherit;border-bottom:1.5px solid transparent}
.lang button[aria-pressed="true"]{color:var(--ink);border-color:var(--accent)}
.burger{display:none;background:none;border:1.5px solid var(--line);width:44px;height:40px;border-radius:3px;cursor:pointer;color:var(--ink);flex-direction:column;justify-content:center;align-items:center;gap:5px}
.burger i{display:block;width:18px;height:1.5px;background:currentColor}
@media (max-width:960px){
 .nav{display:none}
 .nav.open{display:flex;flex-direction:column;position:absolute;top:100%;left:0;right:0;background:var(--bg);border-bottom:1px solid var(--line);padding:10px 24px 20px;gap:0}
 .nav.open a{display:block;padding:12px 0;border-bottom:1px solid var(--line);font-size:17px}
 .tools .btn{display:none}
 .burger{display:flex}
}
/* hero */
.hero{padding-block:clamp(40px,6vw,88px) clamp(36px,5vw,64px)}
.hero .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(32px,5vw,72px);align-items:center}
.hero h1{font-size:clamp(44px,6vw,86px);margin-top:18px;max-width:14ch}
.hero .lead{max-width:48ch;font-size:19px;color:var(--muted);margin-top:26px}
.hero .acts{display:flex;gap:14px;flex-wrap:wrap;margin-top:34px}
.hero .fig{position:relative;aspect-ratio:4/5;overflow:hidden;border-radius:4px;background:#8a8d92}
.hero .cap{position:absolute;left:18px;bottom:18px;background:var(--bg);color:var(--ink);padding:10px 14px;border-radius:3px;font-size:13px;box-shadow:0 8px 24px rgba(0,0,0,.18);max-width:80%}
.hero .cap b{display:block;font-family:var(--fd);font-weight:500;font-size:17px;line-height:1.1;margin-bottom:2px}
@media (max-width:860px){.hero .wrap{grid-template-columns:1fr}.hero .fig{aspect-ratio:4/3}}
/* shade card */
.shades{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding-block:22px;overflow-x:auto;scrollbar-width:thin}
.shades .wrap{display:flex;gap:10px;min-width:max-content}
.shades .lbl{font:500 12.5px/1.2 var(--fb);letter-spacing:.14em;text-transform:uppercase;color:var(--muted);writing-mode:vertical-rl;transform:rotate(180deg);text-align:center;padding:0 2px;flex:none}
.chip{width:78px;flex:none}
.chip i{display:block;height:58px;border-radius:3px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.08)}
.chip b{display:block;font:600 12.5px/1.2 var(--fb);margin-top:8px}
.chip small{display:block;font-size:11px;color:var(--muted);font-variant-numeric:tabular-nums}
[hidden]{display:none!important}
/* pantone card */
.pantone{padding-block:clamp(40px,5vw,64px);border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--bg2)}
.pantone .head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px 40px;flex-wrap:wrap;margin-bottom:22px}
.pantone h2{font-size:clamp(30px,3.6vw,44px);margin-top:10px}
.pantone .head p{color:var(--muted);max-width:56ch;margin-top:10px;font-size:15.5px}
.ptools{display:flex;gap:10px 14px;flex-wrap:wrap;align-items:center;margin-bottom:18px}
.fams{display:flex;gap:6px;flex-wrap:wrap}
.fams button{background:var(--bg);border:1.5px solid var(--line);border-radius:999px;padding:7px 13px;font:500 13px/1 var(--fb);color:var(--ink);cursor:pointer}
.fams button:hover{border-color:var(--ink)}
.fams button[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.psearch{margin-left:auto;display:flex;align-items:center;gap:8px;border:1.5px solid var(--line);border-radius:3px;padding:0 10px;background:var(--bg);color:var(--muted)}
.psearch input{border:0;background:transparent;padding:9px 0;font:400 14px var(--fb);color:var(--ink);min-width:200px;outline:none}
.pgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:12px}
.pchip{position:relative;background:var(--bg);border:1.5px solid var(--line);border-radius:3px;overflow:hidden;cursor:pointer;text-align:left;padding:0;font:inherit;color:inherit;display:flex;flex-direction:column}
.pchip i{display:block;aspect-ratio:5/4;background:var(--c)}
.pchip b{display:block;font:600 11.5px/1.2 var(--fb);letter-spacing:.02em;padding:8px 9px 0;font-variant-numeric:tabular-nums}
.pchip small{display:block;font-size:11px;color:var(--muted);padding:2px 9px 9px;line-height:1.25}
.pchip:hover{border-color:var(--ink)}
.pchip[aria-pressed="true"]{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-soft)}
.pchip .ck{position:absolute;top:8px;right:8px;width:22px;height:22px;border-radius:50%;background:var(--accent);color:#fff;display:none;place-items:center;font-size:13px;box-shadow:0 2px 6px rgba(0,0,0,.25)}
.pchip[aria-pressed="true"] .ck{display:grid}
.pempty{color:var(--muted);padding:24px 0}
.pnote{margin-top:18px;font-size:12.5px;color:var(--muted)}
/* selection tray */
.tray{position:fixed;left:50%;bottom:calc(16px + env(safe-area-inset-bottom,0px));transform:translate(-50%,140%);transition:transform .25s ease;background:var(--ink);color:var(--bg);border-radius:6px;padding:10px 12px 10px 16px;display:flex;align-items:center;gap:14px;z-index:60;box-shadow:0 12px 32px rgba(0,0,0,.3);max-width:calc(100% - 32px)}
.tray.on{transform:translate(-50%,0)}
.tray .sw{display:flex;gap:4px;flex-wrap:wrap;max-width:120px}
.tray .sw i{width:16px;height:16px;border-radius:3px;border:1px solid rgba(128,128,128,.4)}
.tray .n{font-size:14px;white-space:nowrap;font-weight:500}
.tray .btn{padding:10px 16px;font-size:14px;white-space:nowrap}
/* order form */
.order{display:grid;grid-template-columns:1.25fr .75fr;gap:clamp(28px,4vw,56px);align-items:start}
.form{display:grid;gap:26px}
fieldset{border:0;padding:0;margin:0;min-width:0}
legend{font:500 12.5px/1 var(--fb);letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:12px;padding:0}
.opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:10px}
.opt{position:relative;display:block}
.opt input{position:absolute;opacity:0;inset:0;width:100%;height:100%;margin:0;cursor:pointer}
.opt span.box{display:block;border:1.5px solid var(--line);border-radius:3px;padding:12px 14px;font-size:15px;line-height:1.3;background:var(--bg);font-weight:500}
.opt span.box small{display:block;color:var(--muted);font-size:12.5px;margin-top:2px;font-weight:400}
.opt input:checked+span.box{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-soft)}
.opt input:focus-visible+span.box{outline:3px solid var(--accent-t);outline-offset:2px}
.f2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.f2 .full{grid-column:1/-1}
@media (max-width:560px){.f2{grid-template-columns:1fr}}
.fld{display:grid;gap:6px;align-content:start}
.fld label{font-size:14px;font-weight:500}
.fld label small{color:var(--muted);font-weight:400}
.fld input,.fld select,.fld textarea{border:1.5px solid var(--line);border-radius:3px;padding:11px 12px;font:400 15px var(--fb);background:var(--bg);color:var(--ink);width:100%;min-width:0}
.fld input:focus,.fld select:focus,.fld textarea:focus{border-color:var(--accent);outline:none}
.fld textarea{min-height:96px;resize:vertical}
.fmsg{font-size:12.5px;color:#c62828;display:none;margin:0}
.err .fmsg{display:block}
.fld.err input,.fld.err select,.fld.err textarea,fieldset.err .sel .none,.addc input.bad{border-color:#c62828}
.sel{display:grid;gap:8px}
.sel .crow{display:flex;align-items:center;gap:10px;border:1.5px solid var(--line);border-radius:3px;padding:8px 10px;background:var(--bg)}
.sel .crow i{width:30px;height:30px;border-radius:3px;flex:none;border:1px solid rgba(0,0,0,.08)}
.sel .crow .name{flex:1;min-width:0}
.sel .crow b{display:block;font:600 13px/1.2 var(--fb);font-variant-numeric:tabular-nums}
.sel .crow small{display:block;color:var(--muted);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sel .crow input{width:78px;border:1.5px solid var(--line);border-radius:3px;padding:6px 8px;font:400 13px var(--fb);background:var(--bg);color:var(--ink)}
.sel .crow input:focus{border-color:var(--accent);outline:none}
.sel .crow button{background:none;border:0;color:var(--muted);cursor:pointer;font-size:20px;line-height:1;padding:2px 6px}
.sel .crow button:hover{color:#c62828}
.sel .none{color:var(--muted);font-size:14px;border:1.5px dashed var(--line);border-radius:3px;padding:14px}
.addc{display:flex;gap:8px;margin-top:10px}
.addc input{flex:1;min-width:0;border:1.5px solid var(--line);border-radius:3px;padding:10px 12px;font:400 14px var(--fb);background:var(--bg);color:var(--ink)}
.addc input:focus{border-color:var(--accent);outline:none}
.addc .btn{padding:10px 16px;font-size:14px}
.hint{font-size:13px;color:var(--muted);margin-top:8px}
.hint a{color:var(--accent-t);text-decoration:none;font-weight:500}
.check{display:flex;gap:10px;align-items:flex-start;font-size:14px;color:var(--muted);margin-top:14px}
.check input{margin-top:3px;accent-color:var(--accent)}
.check.err{color:#c62828}
.osum{position:sticky;top:calc(92px + env(safe-area-inset-top,0px));background:var(--bg2);border:1.5px solid var(--line);border-radius:4px;padding:24px}
.osum h3{font-size:24px}
.osum dl{display:grid;grid-template-columns:auto 1fr;gap:8px 14px;margin:16px 0 0;font-size:14px}
.osum dt{color:var(--muted)}
.osum dd{margin:0;font-weight:500;overflow-wrap:anywhere}
.osum ol{margin:20px 0 0;padding:16px 0 0 18px;border-top:1px solid var(--line);color:var(--muted);font-size:14px;display:grid;gap:8px}
.done{display:none;border:1.5px solid var(--accent);border-radius:4px;padding:28px;background:var(--accent-soft)}
.done h3{font-size:30px;margin-top:8px}
.done .ref{font-family:var(--fd);font-size:34px;font-variation-settings:"opsz" 144;margin-top:10px;letter-spacing:.02em;font-variant-numeric:tabular-nums}
.done p{color:var(--muted);margin-top:12px;max-width:52ch}
.done pre{white-space:pre-wrap;font:400 13.5px/1.5 ui-monospace,Menlo,Consolas,monospace;background:var(--bg);border:1px solid var(--line);border-radius:3px;padding:14px;margin:18px 0;color:var(--ink)}
.done .acts{display:flex;gap:10px;flex-wrap:wrap}
.order.sent .form{display:none}
.order.sent .done{display:block}
@media (max-width:900px){.order{grid-template-columns:1fr}.osum{position:static}}
@media (prefers-reduced-motion:reduce){.tray{transition:none}}
/* sections */
.sec{padding-block:clamp(60px,8vw,110px)}
.sec-alt{background:var(--bg2)}
.sec-head{max-width:64ch;margin-bottom:clamp(36px,5vw,64px)}
.sec-head h2{font-size:clamp(38px,4.6vw,62px);margin-top:14px}
.sec-head p{color:var(--muted);margin-top:18px;font-size:18px}
.row{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,5vw,72px);align-items:center}
.row+.row{margin-top:clamp(48px,7vw,96px)}
.row.flip .fig{order:2}
.row .fig{aspect-ratio:4/3;overflow:hidden;border-radius:4px;background:#8a8d92}
.count{font-family:var(--fd);font-weight:300;font-size:clamp(52px,6vw,82px);line-height:1;letter-spacing:-.02em;font-variation-settings:"opsz" 144;color:var(--accent-t);font-variant-numeric:tabular-nums}
.count small{font-size:.42em;letter-spacing:0;color:var(--muted);font-weight:400}
.row h3{font-size:clamp(28px,3vw,38px);margin-top:10px}
.row p{margin-top:16px;color:var(--muted);max-width:52ch}
dl.spec{margin:24px 0 0;display:grid;grid-template-columns:auto 1fr;gap:0 24px}
dl.spec div{display:contents}
dl.spec dt{font:500 12.5px/1 var(--fb);letter-spacing:.14em;text-transform:uppercase;color:var(--muted);padding:12px 0;border-top:1px solid var(--line);align-self:center}
dl.spec dd{margin:0;padding:12px 0;border-top:1px solid var(--line);font-size:16px}
.row .more{margin-top:26px}
@media (max-width:820px){.row{grid-template-columns:1fr}.row.flip .fig{order:0}}
/* about */
.state{text-align:center;max-width:30ch;margin:0 auto;font-size:clamp(32px,4.4vw,56px)}
.stats{display:grid;grid-template-columns:repeat(4,1fr);max-width:1040px;margin:clamp(36px,5vw,56px) auto 0}
.stat{padding:8px clamp(12px,2vw,28px);text-align:center;border-left:1px solid var(--line)}
.stat:first-child{border-left:0}
.stat b{display:block;font-family:var(--fd);font-weight:300;font-size:clamp(34px,4.2vw,56px);line-height:1;font-variation-settings:"opsz" 144;font-variant-numeric:tabular-nums;white-space:nowrap}
.stat span{display:block;margin-top:8px;font:500 12.5px/1.3 var(--fb);letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.about-txt{columns:2;column-gap:48px;max-width:1000px;margin:clamp(36px,5vw,56px) auto 0;color:var(--muted);font-size:17px}
.about-txt p+p{margin-top:16px}
.wide{aspect-ratio:21/9;overflow:hidden;border-radius:4px;margin-top:clamp(36px,5vw,64px);background:#6f8b52}
.wcap{display:flex;justify-content:space-between;gap:16px;margin-top:12px;font-size:13px;color:var(--muted)}
@media (max-width:760px){.about-txt{columns:1}.stats{grid-template-columns:1fr 1fr;gap:16px 0}.stat:nth-child(3){border-left:0}}
/* dyeing */
.grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,270px),1fr));gap:clamp(24px,3vw,40px)}
.dye .fig{aspect-ratio:3/4;overflow:hidden;border-radius:4px;background:#8a8d92}
.dye h3{font-size:30px;margin-top:20px}
.dye .kicker{margin-top:8px}
.dye p{color:var(--muted);margin-top:10px}
/* quality */
.certs{display:flex;gap:34px 30px;flex-wrap:wrap;align-items:flex-start;margin-top:8px}
.cert{display:flex;flex-direction:column;align-items:center;text-align:center;gap:10px;color:var(--accent-t);width:118px}
.cert svg{width:82px;height:82px}
.cert span{font-size:12.5px;color:var(--muted);line-height:1.3}
.pol{margin:32px 0 0;padding:0;list-style:none;display:flex;flex-wrap:wrap;gap:10px 0}
.pol li{display:flex;align-items:center}
.pol li+li::before{content:"";width:4px;height:4px;border-radius:50%;background:var(--accent-t);margin:0 16px}
.pol a{text-decoration:none;font-weight:500;font-size:15px;border-bottom:1.5px solid transparent}
.pol a:hover{border-color:currentColor}
/* newsletter */
.nlbox{border:1.5px solid var(--line);border-radius:4px;padding:clamp(28px,4vw,44px);display:flex;align-items:center;justify-content:space-between;gap:24px 48px;flex-wrap:wrap;background:var(--bg)}
.nlbox h3{font-size:30px}
.nlbox p{color:var(--muted);margin-top:8px}
.nl{flex:1 1 360px;max-width:520px}
.nl .fields{display:flex;gap:10px}
.nl input{flex:1;min-width:0;border:1.5px solid var(--line);border-radius:3px;padding:13px 14px;font:400 15px var(--fb);background:var(--bg);color:var(--ink)}
.nl input:focus{border-color:var(--accent);outline:none}
.nl .thanks{display:none;font-weight:600;color:var(--accent-t)}
.nl.done .fields{display:none}.nl.done .thanks{display:block}
/* contact */
.loc{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:36px}
.loc article{border-top:1.5px solid var(--ink);padding-top:18px}
.loc h3{font-size:26px}
.loc p{color:var(--muted);margin-top:10px}
.loc a{display:block;text-decoration:none;font-weight:500;margin-top:6px}
.loc a:hover{color:var(--accent-t)}
/* footer */
footer{border-top:1px solid var(--line);padding-block:48px 28px;font-size:15px}
.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:36px}
footer .logo{margin-bottom:14px}
footer p{color:var(--muted);max-width:36ch}
footer h4{font:500 12.5px/1 var(--fb);letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:0 0 16px}
footer ul{list-style:none;margin:0;padding:0;display:grid;gap:9px}
footer li a{text-decoration:none}
footer li a:hover{color:var(--accent-t)}
.fbot{margin-top:40px;padding-top:18px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:12px 24px;flex-wrap:wrap;color:var(--muted);font-size:13.5px}
.soc{display:flex;gap:18px}
.soc a{text-decoration:none}
.soc a:hover{color:var(--accent-t)}
.grp{font-family:'Alfa Slab One',Georgia,serif;letter-spacing:.04em}
@media (max-width:900px){.fgrid{grid-template-columns:1fr 1fr}}
@media (max-width:520px){.fgrid{grid-template-columns:1fr}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
<script>(function(){var l='uz';try{l=localStorage.getItem('aslip-lang')||l}catch(e){}var r=document.documentElement;r.setAttribute('data-lang',l);r.lang=l;})();</script>
