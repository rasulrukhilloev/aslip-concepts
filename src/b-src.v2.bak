<!--SCENES-->
<script>
(function(){
 var root=document.documentElement;
 function setLang(l){root.setAttribute('data-lang',l);root.lang=l;try{localStorage.setItem('aslip-lang',l)}catch(e){}
  document.querySelectorAll('[data-setlang]').forEach(function(b){b.setAttribute('aria-pressed',String(b.getAttribute('data-setlang')===l))});
  document.querySelectorAll('[data-ph-uz]').forEach(function(i){i.placeholder=l==='uz'?i.getAttribute('data-ph-uz'):i.getAttribute('data-ph-en')});if(window.__orderRerender)window.__orderRerender();}
 document.querySelectorAll('[data-setlang]').forEach(function(b){b.addEventListener('click',function(){setLang(b.getAttribute('data-setlang'))})});
 setLang(root.getAttribute('data-lang')||'uz');
 var burger=document.querySelector('.burger'),nav=document.getElementById('nav');
 if(burger){burger.addEventListener('click',function(){var o=nav.classList.toggle('open');burger.setAttribute('aria-expanded',String(o))});
  nav.addEventListener('click',function(e){if(e.target.closest('a')){nav.classList.remove('open');burger.setAttribute('aria-expanded','false')}});}
 document.querySelectorAll('form.nl').forEach(function(f){f.addEventListener('submit',function(e){e.preventDefault();var inp=f.querySelector('input');if(inp&&inp.value.indexOf('@')>0){f.classList.add('done')}else if(inp){inp.focus()}})});
})();
</script>
<script>
(function(){
 var root=document.documentElement,MAX=8,sel=[],sent=false,lastPayload=null;
 function lang(){return root.getAttribute('data-lang')||'uz'}
 function T(uz,en){return lang()==='uz'?uz:en}
 function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
 /* colour card */
 var chips=[].slice.call(document.querySelectorAll('.pchip')),byCode={};
 chips.forEach(function(c){byCode[c.getAttribute('data-code')]={name:c.getAttribute('data-name'),hex:c.getAttribute('data-hex')}});
 function find(code){for(var i=0;i<sel.length;i++)if(sel[i].code===code)return i;return -1}
 function add(code){if(find(code)>=0||sel.length>=MAX)return false;var k=byCode[code];sel.push({code:code,name:k?k.name:T('Kartadan tashqari kod','Code outside the card'),hex:k?k.hex:'',kg:''});return true}
 function toggle(code){var i=find(code);if(i>=0)sel.splice(i,1);else add(code);render()}
 function remove(code){var i=find(code);if(i>=0)sel.splice(i,1);render()}
 function render(){chips.forEach(function(c){c.setAttribute('aria-pressed',String(find(c.getAttribute('data-code'))>=0))});renderSel();renderTray();summary()}
 chips.forEach(function(c){c.addEventListener('click',function(){toggle(c.getAttribute('data-code'))})});
 var fams=[].slice.call(document.querySelectorAll('.fams button')),fam='all',q='';
 function filter(){var n=0;chips.forEach(function(c){var ok=(fam==='all'||c.getAttribute('data-fam')===fam)&&(!q||(c.getAttribute('data-code')+' '+c.getAttribute('data-name')).toLowerCase().indexOf(q)>=0);c.hidden=!ok;if(ok)n++});document.getElementById('pempty').hidden=n>0}
 fams.forEach(function(b){b.addEventListener('click',function(){fam=b.getAttribute('data-fam');fams.forEach(function(x){x.setAttribute('aria-pressed',String(x===b))});filter()})});
 document.getElementById('psearch').addEventListener('input',function(e){q=e.target.value.trim().toLowerCase();filter()});
 /* selected colours */
 var list=document.getElementById('selList');
 function swatch(hex){return hex||'repeating-linear-gradient(45deg,#cfcfcf 0 4px,#ececec 4px 8px)'}
 function renderSel(){if(!sel.length){list.innerHTML='<div class="none">'+esc(T("Hali rang tanlanmagan. Yuqoridagi ranglar kartasidan tanlang yoki kodni kiriting.","No colours selected yet. Pick from the colour card above or enter a code."))+'</div>';return}
  list.innerHTML='';sel.forEach(function(s){var row=document.createElement('div');row.className='crow';
   row.innerHTML='<i style="background:'+swatch(s.hex)+'"></i><div class="name"><b>'+esc(s.code)+' TCX</b><small>'+esc(s.name)+'</small></div><input type="number" min="0" step="1" inputmode="numeric" placeholder="kg" aria-label="kg" value="'+esc(s.kg)+'"><button type="button" aria-label="'+esc(T('Olib tashlash','Remove'))+'">×</button>';
   row.querySelector('input').addEventListener('input',function(e){s.kg=e.target.value;summary()});
   row.querySelector('button').addEventListener('click',function(){remove(s.code)});
   list.appendChild(row)})}
 var custom=document.getElementById('f-custom');
 function addCustom(){var v=custom.value.trim().toUpperCase().replace(/\s*TCX$/,'');if(!/^\d{2}-\d{4}$/.test(v)){custom.classList.add('bad');custom.focus();return}custom.classList.remove('bad');add(v);custom.value='';render()}
 document.getElementById('addCustom').addEventListener('click',addCustom);
 custom.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();addCustom()}});
 custom.addEventListener('input',function(){custom.classList.remove('bad')});
 /* tray */
 var tray=document.getElementById('tray');
 function renderTray(){tray.classList.toggle('on',sel.length>0&&!sent);tray.querySelector('.sw').innerHTML=sel.map(function(s){return '<i style="background:'+swatch(s.hex)+'"></i>'}).join('');tray.querySelector('.n').textContent=lang()==='uz'?sel.length+' ta rang tanlandi':sel.length+(sel.length===1?' colour selected':' colours selected')}
 /* form */
 var form=document.getElementById('orderForm'),COUNTS={kamvol:[4,6,8,10,12,14,16,20,24,28,32,36,40,48,60],fantaziya:[2,3,4,5,6,8,10,12,16]};
 function product(){return form.product.value}
 function fillCounts(){var s=document.getElementById('f-count'),cur=s.value;s.innerHTML=COUNTS[product()].map(function(n){return '<option value="'+n+'">Nm '+n+'</option>'}).join('');if(cur&&COUNTS[product()].indexOf(+cur)>=0)s.value=cur;document.getElementById('fld-finish').hidden=product()!=='fantaziya'}
 [].forEach.call(form.product,function(r){r.addEventListener('change',function(){fillCounts();summary()})});
 fillCounts();
 function optText(id){var s=document.getElementById(id),o=s.options[s.selectedIndex];return o?(o.getAttribute('data-'+lang())||o.textContent):''}
 function countText(){var ply=document.getElementById('f-ply').value,c=document.getElementById('f-count').value;return 'Nm '+(ply>1?ply+'/':'')+c}
 function productText(){return product()==='kamvol'?T('Kamvol ip','Worsted yarn'):T('Fantaziya ip','Fancy yarn')}
 function summary(){var q=document.getElementById('f-qty').value;document.getElementById('sum').innerHTML=[[T('Mahsulot','Product'),productText()],[T('Nomer','Count'),countText()],[T('Tarkib','Composition'),optText('f-comp')],[T('Shakl','Form'),optText('f-form')],[T('Ranglar','Colours'),sel.length?sel.map(function(s){return s.code}).join(', '):'—'],[T('Miqdor','Quantity'),q?q+' kg':'—']].map(function(p){return '<dt>'+esc(p[0])+'</dt><dd>'+esc(p[1])+'</dd>'}).join('')}
 form.addEventListener('input',summary);form.addEventListener('change',summary);
 function mark(el,bad){var f=el.closest('.fld');if(f)f.classList.toggle('err',!!bad)}
 form.addEventListener('submit',function(e){e.preventDefault();var ok=true,first=null;
  function req(id,test){var el=document.getElementById(id),v=el.value.trim(),bad=test?!test(v):!v;mark(el,bad);if(bad){ok=false;first=first||el}}
  req('f-qty',function(v){return +v>0});req('f-name');req('f-phone',function(v){return v.replace(/\D/g,'').length>=7});req('f-email',function(v){return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v)});
  var fs=document.getElementById('fs-colors');fs.classList.toggle('err',!sel.length);if(!sel.length){ok=false;first=first||custom}
  var consent=document.getElementById('f-consent');consent.closest('.check').classList.toggle('err',!consent.checked);if(!consent.checked){ok=false;first=first||consent}
  if(!ok){first.focus();return}
  finish(collect())});
 function collect(){var g=function(id){return document.getElementById(id).value.trim()};return{ref:makeRef(),sentAt:new Date().toISOString(),lang:lang(),product:product(),count:countText(),composition:g('f-comp'),elastane:g('f-elast'),finish:product()==='fantaziya'?g('f-finish'):'',form:g('f-form'),colours:sel.map(function(s){return{code:s.code,name:s.name,kg:s.kg?+s.kg:null}}),quantityKg:+g('f-qty'),neededBy:g('f-date'),company:g('f-company'),name:g('f-name'),phone:g('f-phone'),email:g('f-email'),city:g('f-city'),comment:g('f-comment')}}
 function makeRef(){var d=new Date(),p=function(n){return(n<10?'0':'')+n};return 'ASL-'+String(d.getFullYear()).slice(2)+p(d.getMonth()+1)+p(d.getDate())+'-'+Math.random().toString(36).slice(2,6).toUpperCase()}
 function text(p){var L=lang()==='uz',o=[];o.push((L?'Ariza':'Order request')+' '+p.ref);o.push((L?'Mahsulot':'Product')+': '+productText());o.push((L?'Nomer':'Count')+': '+p.count);o.push((L?'Tarkib':'Composition')+': '+optText('f-comp'));o.push((L?'Elastan':'Elastane')+': '+optText('f-elast'));if(p.finish)o.push((L?'Ishlov':'Finish')+': '+optText('f-finish'));o.push((L?'Shakl':'Form')+': '+optText('f-form'));o.push((L?'Ranglar':'Colours')+':');p.colours.forEach(function(c){o.push('  - '+c.code+' TCX '+c.name+(c.kg?' · '+c.kg+' kg':''))});o.push((L?'Umumiy miqdor':'Total quantity')+': '+p.quantityKg+' kg');if(p.neededBy)o.push((L?'Kerakli muddat':'Needed by')+': '+p.neededBy);o.push('');if(p.company)o.push((L?'Kompaniya':'Company')+': '+p.company);o.push((L?'Ism':'Name')+': '+p.name);o.push((L?'Telefon':'Phone')+': '+p.phone);o.push('Email: '+p.email);if(p.city)o.push((L?'Shahar / mamlakat':'City / country')+': '+p.city);if(p.comment){o.push('');o.push((L?'Izoh':'Comment')+': '+p.comment)}return o.join('\n')}
 /* Delivery stub: replace the body of sendApplication with a fetch() to the real endpoint (email service, Google Sheet, Telegram bot or CRM). */
 function sendApplication(p){try{var arr=JSON.parse(localStorage.getItem('aslip-applications')||'[]');arr.push(p);localStorage.setItem('aslip-applications',JSON.stringify(arr.slice(-20)))}catch(e){}return Promise.resolve({ok:true})}
 function finish(p){lastPayload=p;window.ASLIP_LAST_APPLICATION=p;sendApplication(p);sent=true;document.getElementById('orderWrap').classList.add('sent');document.getElementById('ref').textContent=p.ref;document.getElementById('sumText').textContent=text(p);document.getElementById('mailto').href='mailto:info@aslip.uz?subject='+encodeURIComponent((lang()==='uz'?'Ariza ':'Order request ')+p.ref)+'&body='+encodeURIComponent(text(p));renderTray();document.getElementById('done').scrollIntoView({behavior:'smooth',block:'start'})}
 document.getElementById('copyBtn').addEventListener('click',function(){var b=this,t=document.getElementById('sumText').textContent;function ok(){b.textContent=T('Nusxa olindi','Copied')}function fb(){var ta=document.createElement('textarea');ta.value=t;document.body.appendChild(ta);ta.select();try{document.execCommand('copy');ok()}catch(e){}document.body.removeChild(ta)}if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(t).then(ok,fb)}else fb()});
 document.getElementById('againBtn').addEventListener('click',function(){sent=false;document.getElementById('orderWrap').classList.remove('sent');form.reset();fillCounts();sel=[];render();document.getElementById('order').scrollIntoView({behavior:'smooth'})});
 window.__orderRerender=function(){document.querySelectorAll('option[data-uz]').forEach(function(o){o.textContent=o.getAttribute('data-'+lang())});renderSel();renderTray();summary();if(sent&&lastPayload){document.getElementById('sumText').textContent=text(lastPayload)}};
 window.__orderRerender();
})();
</script>
